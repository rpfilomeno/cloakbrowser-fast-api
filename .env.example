# Copy to .env and adjust. All values optional; unset = defaults from README.

# --- API ---
AUTH_TOKEN=
PORT=8000
MAX_CONCURRENT_SCRAPES=3
# DEBUG | INFO | WARNING | ERROR — applies to app logs and uvicorn access logs
LOG_LEVEL=INFO

# --- Proxy ---
PROXY_URL=

# --- CloakBrowser ---
# Free key: run `cloakbrowser login` or visit https://cloakbrowser.dev/free
CLOAKBROWSER_LICENSE_KEY=
CB_HEADLESS=true
CB_HUMANIZE=false
CB_HUMAN_PRESET=
CB_GEOIP=false
CB_TIMEZONE=
CB_LOCALE=
CB_USER_AGENT=
CB_ARGS=
CB_LAUNCH_KWARGS=
